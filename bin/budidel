#!/bin/bash

# ============================================================
#  budidel — удаление напоминания budi по номеру
# ============================================================
#  Использование:
#    budidel НОМЕР
#  Номер берётся из первой колонки budilist.
# ============================================================

LOG="$HOME/.budi.log"

if [ -z "$1" ]; then
    echo "Использование: budidel НОМЕР_ЗАДАЧИ"
    echo "Номера смотри в budilist"
    exit 1
fi

if atrm "$1" 2>/dev/null; then
    echo "Задача $1 удалена"
    echo "$(date '+%Y-%m-%d %H:%M:%S') | Удалено: job=$1" >> "$LOG"
else
    echo "Не удалось удалить задачу $1 (нет такой или уже выполнена)"
fi
