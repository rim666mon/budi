#!/bin/bash

# ============================================================
#  budilist — список напоминаний budi
# ============================================================

LOG="$HOME/.budi.log"

GREEN='\033[0;32m'
YELLOW='\033[0;33m'
RED='\033[0;31m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

NOW=$(date '+%s')

# --- Заголовок с датой ---
TODAY_STR=$(date '+%d %B, %H:%M (%A)')
echo -e "${BOLD}${CYAN}📅 Сегодня: ${TODAY_STR}${NC}"
echo

echo -e "${BOLD}${CYAN}── Активные напоминания ──${NC}"

FOUND=0
COUNT=0
NEAREST_TS=""

while read -r JOB REST; do
    TIME=$(echo "$REST" | awk '{$(NF-1)=""; $NF=""; print}' | sed 's/  */ /g' | sed 's/ $//')

    MSG=$(at -c "$JOB" 2>/dev/null \
          | grep -oP 'notify-send\s+.*?\x27Будильник[^\x27]*\x27\s+\x27\K[^\x27]*' \
          | head -n1)

    if [ -z "$MSG" ]; then
        MSG=$(at -c "$JOB" 2>/dev/null \
              | grep -oP "text='🔔 \K[^']*" \
              | head -n1)
    fi

    [ -z "$MSG" ] && MSG="(без описания)"

    JOB_TS=$(date -d "$TIME" '+%s' 2>/dev/null)

    if [ -n "$JOB_TS" ] && [ "$JOB_TS" -le "$NOW" ]; then
        printf "${RED}%-4s %-28s %s${NC}\n" "$JOB" "$TIME" "$MSG"
    elif [ -n "$JOB_TS" ] && [ $((JOB_TS - NOW)) -le 300 ]; then
        printf "${YELLOW}%-4s %-28s %s${NC}\n" "$JOB" "$TIME" "$MSG"
    else
        printf "${GREEN}%-4s %-28s %s${NC}\n" "$JOB" "$TIME" "$MSG"
    fi
    FOUND=1
    COUNT=$((COUNT + 1))

    # Обновляем ближайшее будущее
    if [ -n "$JOB_TS" ] && [ "$JOB_TS" -gt "$NOW" ]; then
        if [ -z "$NEAREST_TS" ] || [ "$JOB_TS" -lt "$NEAREST_TS" ]; then
            NEAREST_TS="$JOB_TS"
        fi
    fi
done < <(atq)

[ "$FOUND" -eq 0 ] && echo "  (пусто)"

# --- Сводка ---
if [ "$COUNT" -gt 0 ] && [ -n "$NEAREST_TS" ]; then
    DIFF=$((NEAREST_TS - NOW))
    HOURS=$((DIFF / 3600))
    MINS=$(( (DIFF % 3600) / 60 ))

    if [ "$HOURS" -gt 0 ]; then
        NEAREST_STR="${HOURS}ч ${MINS}м"
    else
        NEAREST_STR="${MINS}м"
    fi

    echo
    echo -e "${BOLD}${CYAN}── Итого ──${NC}"
    echo -e "  Всего активных: ${BOLD}${COUNT}${NC}. Ближайшее: ${GREEN}через ${NEAREST_STR}${NC}."
fi

if [ -f "$LOG" ]; then
    echo
    echo -e "${BOLD}${CYAN}── История (последние 10) ──${NC}"
    grep -E "Создано:|Удалено:" "$LOG" | tail -n10 | tac | while IFS= read -r line; do
        echo "  $line"
    done
fi
